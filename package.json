{
  "name": "procedural-terrain-laboratory",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "A vanilla JavaScript laboratory for procedural heightfields and erosion.",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
